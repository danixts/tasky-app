{
	"info": {
		"name": "Tasky API",
		"description": "API for task management - Mini Trello",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:9000",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		},
		{
			"key": "refresh_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "task_id",
			"value": "",
			"type": "string"
		}
	],
	"auth": {
		"type": "apikey",
		"apikey": [
			{
				"key": "key",
				"value": "Authorization",
				"type": "string"
			},
			{
				"key": "value",
				"value": "Token {{token}}",
				"type": "string"
			},
			{
				"key": "in",
				"value": "header",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var json = pm.response.json();",
									"if (json.data && json.data.token) {",
									"    pm.collectionVariables.set('token', json.data.token);",
									"    pm.collectionVariables.set('refresh_token', json.data.refreshToken);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"daniel\",\n    \"password\": \"1234\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/login",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "login"]
						},
						"description": "Login and get JWT token. Saves token and refresh_token automatically."
					}
				},
				{
					"name": "Refresh Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var json = pm.response.json();",
									"if (json.data && json.data.token) {",
									"    pm.collectionVariables.set('token', json.data.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"refreshToken\": \"{{refresh_token}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/refresh",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "refresh"]
						},
						"description": "Refresh access token using a valid refresh token."
					}
				},
				{
					"name": "Logout",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/auth/logout",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "logout"]
						},
						"description": "Logout and revoke all tokens."
					}
				}
			]
		},
		{
			"name": "Tasks",
			"item": [
				{
					"name": "Get Board",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/tasks/board",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "tasks", "board"]
						},
						"description": "Get tasks grouped by status (PENDING, IN_PROGRESS, COMPLETED) for board view."
					}
				},
				{
					"name": "List Tasks",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/tasks",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "tasks"]
						},
						"description": "List all tasks for the authenticated user."
					}
				},
				{
					"name": "List Tasks by Status",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/tasks?status=PENDING",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "tasks"],
							"query": [
								{
									"key": "status",
									"value": "PENDING",
									"description": "PENDING | IN_PROGRESS | COMPLETED"
								}
							]
						},
						"description": "List tasks filtered by status."
					}
				},
				{
					"name": "Get Task by ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/tasks/{{task_id}}",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "tasks", "{{task_id}}"]
						},
						"description": "Get a single task by its ID."
					}
				},
				{
					"name": "Create Task",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var json = pm.response.json();",
									"if (json.data && json.data.taskId) {",
									"    pm.collectionVariables.set('task_id', json.data.taskId);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"New Task\",\n    \"description\": \"Task description\",\n    \"status\": \"PENDING\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/tasks",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "tasks"]
						},
						"description": "Create a new task. Saves task_id automatically."
					}
				},
				{
					"name": "Update Task",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"Updated Task\",\n    \"description\": \"Updated description\",\n    \"status\": \"IN_PROGRESS\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/tasks/{{task_id}}",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "tasks", "{{task_id}}"]
						},
						"description": "Update an existing task (title, description, status)."
					}
				},
				{
					"name": "Move Task (Drag & Drop)",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"status\": \"COMPLETED\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/tasks/{{task_id}}/move",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "tasks", "{{task_id}}", "move"]
						},
						"description": "Move a task to a different status column (drag & drop)."
					}
				},
				{
					"name": "Delete Task",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/tasks/{{task_id}}",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "tasks", "{{task_id}}"]
						},
						"description": "Delete a task."
					}
				}
			]
		}
	]
}
