{
  "name": "tasky-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "turbo run dev --filter=web",
    "build": "turbo run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "preview": "turbo run preview --filter=web",
    "server": "node server.mjs"
  },
  "dependencies": {
    "@fastify/http-proxy": "^11.1.1",
    "@fastify/static": "^8.0.1",
    "fastify": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "^2.8.3",
    "typescript": "~5.9.3"
  }
